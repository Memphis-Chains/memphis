#!/usr/bin/env sh
# Managed via core.hooksPath — see scripts/setup-githooks.mjs.
#
# lint is unconditional; it is fast enough to always pay for.
#
# The mutation gate is conditional on the files it actually mutates. Running
# it on every commit would tax unrelated work for nothing — it spawns vitest
# and tsx, and its mutations only mean something when one of those files is
# in the diff.
#
# The systemd unit gate is conditional on the same principle: it only means
# something when a unit file is in the diff.
set -e

npm run lint

STAGED="$(git diff --cached --name-only)"

GUARDED='scripts/pii-scan.sh
scripts/default-secret-scan.sh
sites/memphis-v5/api/_boot.php
scripts/sync-site-metrics.mts
scripts/sync-native-tiers.mts
tests/unit/site-claims-contract.test.ts
crates/memphis-operator/src/chat_tool_catalog.rs
sites/memphis-v5/index.html
src/security/content-scan.ts'

NEEDS_MUTATION_GATE=0
for file in $GUARDED; do
  if printf '%s\n' "$STAGED" | grep -qx "$file"; then
    NEEDS_MUTATION_GATE=1
    break
  fi
done

if [ "$NEEDS_MUTATION_GATE" -eq 1 ]; then
  npm run -s ops:mutation-gate
fi

# Two alert units shipped as a 71-byte stub with no [Service] section, so
# systemd refused to run them on every boot and a failed digest was never
# reported to the operator. Run the unit gate whenever a unit file is in
# the diff.
NEEDS_SYSTEMD_GATE=0
for file in $STAGED; do
  case "$file" in
    scripts/systemd/*.service|scripts/systemd/*.timer)
      NEEDS_SYSTEMD_GATE=1
      break
      ;;
  esac
done

if [ "$NEEDS_SYSTEMD_GATE" -eq 1 ]; then
  npm run -s ops:check-systemd-units
fi

# The chain corpus is the runtime's memory. Postmortem item C2: "A pre-commit
# git hook running `memphis chain verify` over the chains a change touches.
# Any block failing the schema blocks the commit."
#
# Two triggers, because there are two ways a change can reach the corpus:
#   - a staged change UNDER chains/ — the corpus itself changed;
#   - a staged change to the code that READS the corpus — the corpus did not
#     change, but the reader did, and a reader that cannot read the corpus is
#     the defect this catches. (MEASURED on the live corpus: 66 blocks of the
#     chain tails in 2 s.)
#
# The sweep asks the native core when the core is loadable, so a green line
# means "the core can read these blocks", not "the JSON parsed".
NEEDS_CHAIN_SWEEP=0
CHAINS_DIR_TO_SWEEP=""
for file in $STAGED; do
  case "$file" in
    chains/*)
      NEEDS_CHAIN_SWEEP=1
      CHAINS_DIR_TO_SWEEP="chains"
      break
      ;;
    src/infra/storage/chain-*|src/infra/memory/exact-search.ts|src/infra/storage/chain-archive-*|src/core/chain-hash.ts|src/core/block-payload.ts|crates/memphis-chain/*)
      NEEDS_CHAIN_SWEEP=1
      CHAINS_DIR_TO_SWEEP="${MEMPHIS_HOME:-$HOME/.memphis}/chains"
      break
      ;;
  esac
done

if [ "$NEEDS_CHAIN_SWEEP" -eq 1 ]; then
  echo "pre-commit: sweeping the chain corpus in $CHAINS_DIR_TO_SWEEP"
  CHAINS_DIR="$CHAINS_DIR_TO_SWEEP" node scripts/chain-integrity-sweep.mjs
fi

# Every skill must declare where it writes, and nothing may write under
# chains/ — the shape that crashed Memphis on 2026-09-22. The rule is in
# src/infra/audit/skill-sidecar-contract.ts; this is its runner over the
# skills in the repository.
NEEDS_SKILL_CONTRACT_GATE=0
for file in $STAGED; do
  case "$file" in
    skills/*)
      NEEDS_SKILL_CONTRACT_GATE=1
      break
      ;;
  esac
done

if [ "$NEEDS_SKILL_CONTRACT_GATE" -eq 1 ]; then
  npm run -s ops:check-skill-contracts
fi
