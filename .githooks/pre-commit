#!/usr/bin/env sh
# Managed via core.hooksPath — see scripts/setup-githooks.mjs.
#
# lint is unconditional; it is fast enough to always pay for.
#
# The mutation gate is conditional on the files it actually mutates. Running
# it on every commit would tax unrelated work for nothing — it spawns vitest
# and tsx, and its mutations only mean something when one of those files is
# in the diff.
#
# The systemd unit gate is conditional on the same principle: it only means
# something when a unit file is in the diff.
set -e

npm run lint

STAGED="$(git diff --cached --name-only)"

GUARDED='scripts/pii-scan.sh
scripts/default-secret-scan.sh
sites/memphis-v5/api/_boot.php
scripts/sync-site-metrics.mts
scripts/sync-native-tiers.mts
tests/unit/site-claims-contract.test.ts
crates/memphis-operator/src/chat_tool_catalog.rs
sites/memphis-v5/index.html
src/security/content-scan.ts'

NEEDS_MUTATION_GATE=0
for file in $GUARDED; do
  if printf '%s\n' "$STAGED" | grep -qx "$file"; then
    NEEDS_MUTATION_GATE=1
    break
  fi
done

if [ "$NEEDS_MUTATION_GATE" -eq 1 ]; then
  npm run -s ops:mutation-gate
fi

# Two alert units shipped as a 71-byte stub with no [Service] section, so
# systemd refused to run them on every boot and a failed digest was never
# reported to the operator. Run the unit gate whenever a unit file is in
# the diff.
NEEDS_SYSTEMD_GATE=0
for file in $STAGED; do
  case "$file" in
    scripts/systemd/*.service|scripts/systemd/*.timer)
      NEEDS_SYSTEMD_GATE=1
      break
      ;;
  esac
done

if [ "$NEEDS_SYSTEMD_GATE" -eq 1 ]; then
  npm run -s ops:check-systemd-units
fi
