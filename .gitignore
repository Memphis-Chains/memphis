# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
# npm-generated package-lock.json. Canonical lockfile is npm-shrinkwrap.json
# (rename in PR #546 / commit b1dce43, 2026-05-08; publish-time advisory pin
# for consumers of @memphis-chains/memphis on npm). This artifact would shadow
# npm-shrinkwrap.json if accidentally staged via `git add .`. Tools that don't
# honor npm-shrinkwrap (e.g. plain `npm install` in dev environments) generate
# it; the .gitignore entry stops it from leaking into commits.
package-lock.json
dist/
coverage/
.tools/

# ── Secrets & credentials (NEVER publish) ────────────────────────────────────
.env
.env.*
!.env.example
*.secret
*.pem
*.key
# Credential-material file types. 2026-10-09: the list above covered .pem
# and .key but not the rest, so `sites/memphis-v5/docs/internal/.htpasswd`
# — a real password hash — was committed to a PUBLIC repo. A guard keyed on
# one extension list is only as good as the last extension added to it.
# Kept in step with SECRET_FILE_TYPES in scripts/pii-scan.sh: gitignore
# stops it being added, the scan stops it being committed.
*.htpasswd
*.htdigest
*.p12
*.pfx
*.jks
*.keystore
*.ppk
*.kdbx
*.age
*.tfstate
credentials/
.config/memphis/tokens/
.claude/settings.local.json

