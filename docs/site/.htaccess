# Memphis v5 — https://memphis-v5.pl/public_html/memphis-v5/.htaccess
# Maintained from RPi via ~/memphis skills. Last change: 2026-09-28 (ErrorDocument + compression + caching + headers)

# ── HTTPS + HSTS ─────────────────────────────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
</IfModule>

<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # Security headers
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"

    # No caching of HTML — content changes often, and this is a small static site
    <FilesMatch "\.(html|json|txt|xml|webmanifest)$">
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </FilesMatch>

    # Long cache for static assets (favicon, images)
    <FilesMatch "\.(svg|ico|jpg|jpeg|png|webp|gif|woff2?)$">
        Header set Cache-Control "public, max-age=2592000, immutable"
    </FilesMatch>
</IfModule>

# ── Custom error page ────────────────────────────────────────
ErrorDocument 404 /404.html

# ── Compression ──────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/manifest+json
    AddOutputFilterByType DEFLATE application/xml application/xml+rss
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ── MIME types ───────────────────────────────────────────────
<IfModule mod_mime.c>
    AddType image/svg+xml .svg
    AddType image/x-icon .ico
    AddType application/manifest+json .webmanifest
    AddType text/plain .txt
</IfModule>

# ── Directory listing off ────────────────────────────────────
Options -Indexes
DirectoryIndex index.html

# ── Block backup / editor / dev artifacts ─────────────────────
# Backups must live in ~/site-backups/, never in the docroot.
# Without this, every deploy that snapshots in place leaks a full
# copy of the site to anyone who guesses the filename.
<FilesMatch "\.(bak|backup|old|orig|save|swp|swo|tmp|temp|log|sql|sqlite|sqlite3|ini|env)$">
    Require all denied
</FilesMatch>

<FilesMatch "^(README|readme|CHANGELOG|LICENSE|CONTRIBUTING|Makefile|Dockerfile|composer\.(json|lock)|package(-lock)?\.json|ya?ml)$">
    Require all denied
</FilesMatch>

# Two or more dots in a name = editor temp or double extension trick
<FilesMatch "\..+\.">
    Require all denied
</FilesMatch>

# Any file containing "backup" or "bak" in the name, any extension
<FilesMatch ".*(backup|bak).*">
    Require all denied
</FilesMatch>
