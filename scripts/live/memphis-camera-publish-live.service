[Unit]
Description=Memphis camera → marcin-kukla.pl/live publisher
Documentation=https://marcin-kukla.pl/live/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/home/memphis/memphis/scripts/live/memphis-camera-publish-live.sh /dev/video1 2
Restart=on-failure
RestartSec=5
Environment=DISPLAY=:0.0
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target