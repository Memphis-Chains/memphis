[Unit]
Description=LR Dashboard managed app (port 3001)
After=network-online.target memphis.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/home/memphis/projects/lr-dashboard
EnvironmentFile=/home/memphis/projects/lr-dashboard/.env
Environment=HOST=127.0.0.1
Environment=PORT=3001
Environment=MEMPHIS_DATA_DIR=/home/memphis/.memphis
Environment=MEMPHIS_APPS_DIR=/home/memphis/.memphis/apps
Environment=APP_ID=lr-dashboard
Environment=APP_ROOT=/home/memphis/.memphis/apps/lr-dashboard
Environment=APP_HOME=/home/memphis/projects/lr-dashboard
Environment=APP_STATE_DIR=/home/memphis/.memphis/apps/lr-dashboard/state
Environment=APP_CONFIG_PATH=/home/memphis/.memphis/apps/lr-dashboard/config/app.json
Environment=LR_DASHBOARD_HOME=/home/memphis/projects/lr-dashboard
Environment=LR_DASHBOARD_STATE_DIR=/home/memphis/.memphis/apps/lr-dashboard/state
Environment=LR_DASHBOARD_CONFIG_PATH=/home/memphis/.memphis/apps/lr-dashboard/config/app.json
Environment=LR_DB_PATH=/home/memphis/.memphis/apps/lr-dashboard/state/lr.sqlite
Environment=LR_BACKUP_DIR=/home/memphis/.memphis/apps/lr-dashboard/state/backups
Environment=LR_PID_FILE=/home/memphis/.memphis/apps/lr-dashboard/state/lr-dashboard.pid
Environment=LR_LOG_FILE=/home/memphis/.memphis/apps/lr-dashboard/state/lr-dashboard.log
Environment=LR_LOG_REQUESTS=0
# `StandardOutput=append:` does not create missing parent directories, and
# systemd opens stdout BEFORE running ExecStartPre — so an ExecStartPre mkdir
# dies at step STDOUT itself with 209/STDOUT (measured 2026-10-08; that was
# my first attempt and it did not work). The directory has to exist before
# the unit is started; `scripts/systemd/install-managed-app-units.sh`
# creates it, and StartLimitBurst now caps the failure instead of looping.
#
# Observed cost of leaving it out: 325 restarts in 12 h, each writing the
# same 209/STDOUT line every 5 s.
ExecStart=/usr/bin/node /home/memphis/projects/lr-dashboard/src/server.js
Restart=on-failure
# Stop hammering the journal when the failure is structural (bad ExecStart,
# missing .env) rather than transient.
RestartSec=15
StandardOutput=append:/home/memphis/.memphis/apps/lr-dashboard/state/lr-dashboard.systemd.log
StandardError=append:/home/memphis/.memphis/apps/lr-dashboard/state/lr-dashboard.systemd.log

[Install]
WantedBy=default.target
