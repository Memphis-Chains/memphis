[Unit]
Description=Memphis public chat with MiniMax and local inference
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/memphis
ExecStart=/usr/bin/node --permission --allow-fs-read=%h/memphis/scripts/public-chat-gateway.mjs --allow-fs-read=%h/memphis/sites/memphis-v5/chat --allow-fs-read=%h/memphis/sites/memphis-v5/favicon.svg %h/memphis/scripts/public-chat-gateway.mjs
Environment=PUBLIC_CHAT_HOST=127.0.0.1
Environment=PUBLIC_CHAT_PORT=9100
Environment=PUBLIC_CHAT_TRUST_PROXY=1
Environment=PUBLIC_CHAT_MINIMAX_SOCKET=%t/memphis-public-provider/inference.sock
UnsetEnvironment=NODE_OPTIONS NODE_PATH
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
NoNewPrivileges=yes
UMask=0077
MemoryMax=192M
TasksMax=32

[Install]
WantedBy=default.target
