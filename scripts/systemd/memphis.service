[Unit]
Description=Memphis local runtime
After=network-online.target
Wants=network-online.target
# A crash loop must not become a boot loop. `Restart=on-failure` below
# restarts the service; these two directives cap how often that can
# happen, so a persistent failure stops instead of spinning.
StartLimitBurst=5
StartLimitIntervalSec=300

[Service]
Type=simple
WorkingDirectory=%h/memphis
ExecStart=/usr/bin/node %h/memphis/dist/infra/cli/index.js serve
# `always`, and the reason is MEASURED.
#
# The runtime drains cleanly on SIGTERM and exits 0 — and a clean drain IS
# a clean exit. `on-failure` reads a clean exit as "the service did what it
# was told to do", so the unit stayed DOWN: MEASURED 2026-11-25 on this
# host, an UNSOLICITED SIGTERM (not `systemctl stop`) left the unit
# `inactive` with pid 0, and nothing in the log said why. The operator
# cannot tell "the runtime stopped on purpose" from "the runtime is gone".
#
# `always` does not fight the operator. systemd does not restart a unit the
# operator stopped — MEASURED with a scratch unit on this host: an
# unsolicited SIGTERM brought it back (new pid), and `systemctl stop` left
# it `inactive`. The runtime's own drain logs its reason (`shutdown.start`
# carries it), so the restart is visible rather than mysterious.
#
# Exit codes 101/102/103 (integrity fail / config error / startup fail)
# still stop the supervisor from looping on the same crash, and
# StartLimitBurst=5 still caps a boot loop.
Restart=always
RestartSec=5
RestartPreventExitStatus=101 102 103

# Resource limits.
#
# These were absent, and the absence was measurable. The runtime's own
# cgroup peaked at 3.4 GB and the whole app slice at 9.6 GB with 1.4 GB
# of swap in use, with nothing above it to stop it: the kernel OOM killer
# had to act, and the operator saw the runtime die for no visible reason.
#
# MemoryHigh is the soft limit — the kernel starts reclaiming under
# pressure, before the runtime is in trouble. MemoryMax is the hard one:
# the process is killed, and `Restart=on-failure` brings a clean one
# back. `OOMPolicy=kill` makes systemd kill the unit's process rather
# than stopping the whole unit, so the recovery path is the same one a
# crash takes.
#
# The service's own measured peak is 3.4 GB — the boot-time chain
# verification holds every block of every chain in memory at once — so
# 4 GB leaves headroom without letting a leak reach the kernel.
MemoryHigh=2G
MemoryMax=4G
OOMPolicy=kill

# A drain that never finishes must not hold the unit open for the
# default 90 seconds on every restart.
TimeoutStopSec=45

EnvironmentFile=%h/memphis/.env
Environment=HOME=%h
Environment=NODE_ENV=development
Environment=PATH=/usr/bin:%h/.cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

[Install]
WantedBy=default.target
