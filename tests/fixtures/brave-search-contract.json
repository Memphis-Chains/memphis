{
  "description": "The cases where the native arm of memphis_brave_search (crates/memphis-operator/src/brave_search.rs) and the TypeScript arm (src/mcp/tools/brave-search.ts) must answer the same way. Checked by a test in Rust (crates/memphis-operator/tests/brave_search_contract.rs) and a test in TypeScript (tests/unit/mcp-brave-search-contract.test.ts). The case table is the arbitration: a change in one arm that the other does not share fails a test in BOTH languages.",
  "cases": [
    {
      "name": "the default count is ten",
      "call": { "query": "Rozwój DG LGD", "key": "BSAtest" },
      "response": {
        "status": 200,
        "body": {
          "web": {
            "results": [
              { "title": "T1", "url": "https://a.example/1", "description": "Pierwszy" }
            ]
          }
        }
      },
      "expect": {
        "ok": true,
        "count": 1,
        "url": "https://api.search.brave.com/res/v1/web/search?q=Rozw%C3%B3j+DG+LGD&count=10",
        "params": { "q": "Rozwój DG LGD", "count": "10" },
        "results": [
          { "title": "T1", "url": "https://a.example/1", "description": "Pierwszy", "source": "web" }
        ]
      }
    },
    {
      "name": "a count below one is raised to one",
      "call": { "query": "x", "limit": 0, "key": "BSAtest" },
      "response": { "status": 200, "body": {} },
      "expect": {
        "ok": true,
        "count": 0,
        "url": "https://api.search.brave.com/res/v1/web/search?q=x&count=1",
        "params": { "q": "x", "count": "1" }
      }
    },
    {
      "name": "a count above the cap is lowered to the cap",
      "call": { "query": "x", "limit": 99, "key": "BSAtest" },
      "response": { "status": 200, "body": {} },
      "expect": {
        "ok": true,
        "count": 0,
        "url": "https://api.search.brave.com/res/v1/web/search?q=x&count=20",
        "params": { "q": "x", "count": "20" }
      }
    },
    {
      "name": "a fractional count is floored and caps the results",
      "call": { "query": "x", "limit": 2.7, "key": "BSAtest" },
      "response": {
        "status": 200,
        "body": {
          "web": {
            "results": [
              { "title": "A", "url": "https://a.example" },
              { "title": "B", "url": "https://b.example" },
              { "title": "C", "url": "https://c.example" }
            ]
          }
        }
      },
      "expect": {
        "ok": true,
        "count": 2,
        "params": { "q": "x", "count": "2" }
      }
    },
    {
      "name": "an empty query is refused before the request",
      "call": { "query": "   ", "key": "BSAtest" },
      "expect": {
        "ok": false,
        "error": "Query is empty",
        "noRequest": true
      }
    },
    {
      "name": "a missing key is refused before the request",
      "call": { "query": "x" },
      "expect": {
        "ok": false,
        "error": "BRAVE_API_KEY not set. Get a key at https://api.search.brave.com/ (free 2000 queries/month), then run `memphis brave configure --key <token>`.",
        "noRequest": true
      }
    },
    {
      "name": "an unresolved vault reference is refused before the request",
      "call": { "query": "x", "key": "VAULT:brave_api_key" },
      "expect": {
        "ok": false,
        "error": "BRAVE_API_KEY references vault entry \"brave_api_key\" but vault didn't resolve it. Run `memphis brave configure --key <token>` or set BRAVE_API_KEY directly.",
        "noRequest": true
      }
    },
    {
      "name": "web results come before news results",
      "call": { "query": "x", "key": "BSAtest" },
      "response": {
        "status": 200,
        "body": {
          "web": {
            "results": [{ "title": "W", "url": "https://w.example", "description": "w" }]
          },
          "news": {
            "results": [{ "title": "N", "url": "https://n.example", "description": "n" }]
          }
        }
      },
      "expect": {
        "ok": true,
        "count": 2,
        "results": [
          { "title": "W", "url": "https://w.example", "description": "w", "source": "web" },
          { "title": "N", "url": "https://n.example", "description": "n", "source": "news" }
        ]
      }
    },
    {
      "name": "a result without a url is dropped",
      "call": { "query": "x", "key": "BSAtest" },
      "response": {
        "status": 200,
        "body": {
          "web": {
            "results": [
              { "title": "Bez URL" },
              { "title": "Pusty URL", "url": "" },
              { "title": "Dobra", "url": "https://ok.example", "description": "d" }
            ]
          }
        }
      },
      "expect": {
        "ok": true,
        "count": 1,
        "results": [
          { "title": "Dobra", "url": "https://ok.example", "description": "d", "source": "web" }
        ]
      }
    },
    {
      "name": "html is stripped from the description",
      "call": { "query": "x", "key": "BSAtest" },
      "response": {
        "status": 200,
        "body": {
          "web": {
            "results": [
              { "title": "T", "url": "https://t.example", "description": "<b>Pogrubiony</b> opis" }
            ]
          }
        }
      },
      "expect": {
        "ok": true,
        "count": 1,
        "results": [
          { "title": "T", "url": "https://t.example", "description": "Pogrubiony opis", "source": "web" }
        ]
      }
    },
    {
      "name": "the region and the language reach the vendor",
      "call": {
        "query": "Rozwój DG & spółka",
        "limit": 2,
        "country": "PL",
        "search_lang": "pl",
        "key": "BSAtest"
      },
      "response": { "status": 200, "body": {} },
      "expect": {
        "ok": true,
        "count": 0,
        "url": "https://api.search.brave.com/res/v1/web/search?q=Rozw%C3%B3j+DG+%26+sp%C3%B3%C5%82ka&count=2&country=PL&search_lang=pl",
        "params": {
          "q": "Rozwój DG & spółka",
          "count": "2",
          "country": "PL",
          "search_lang": "pl"
        }
      }
    },
    {
      "name": "a rejected key is reported with the status",
      "call": { "query": "x", "key": "BSAtest" },
      "response": { "status": 401, "bodyText": "bad key" },
      "expect": {
        "ok": false,
        "error": "Brave Search API error: HTTP 401 (BRAVE_API_KEY rejected — check it) bad key"
      }
    },
    {
      "name": "a rate limit is reported with the status",
      "call": { "query": "x", "key": "BSAtest" },
      "response": { "status": 429, "bodyText": "too many" },
      "expect": {
        "ok": false,
        "error": "Brave Search API error: HTTP 429 (rate limit hit — Brave free tier is 1 query/sec) too many"
      }
    },
    {
      "name": "a rejected request without a known cause still reports the status",
      "call": { "query": "x", "key": "BSAtest" },
      "response": { "status": 422, "bodyText": "bad query" },
      "expect": {
        "ok": false,
        "error": "Brave Search API error: HTTP 422 bad query"
      }
    }
  ]
}
