      "dimension": "RUST_EMBED_DIM",
      "model": "RUST_EMBED_PROVIDER_MODEL",
      "mode": "RUST_EMBED_MODE"
    },
    "defaults": {
      "indexPath": "<data_dir>/embed/index-v1.json",
      "dimension": "the dimension recorded in the index on disk; DEFAULT_EMBEDDING_DIM when no index exists",
      "model": "unknown — a model cannot be derived from an index, so it must be configured",
      "localDimension": 32
    },
    "dimensionSources": [
      "env",
      "index",
      "local-deterministic"
    ],
    "verdicts": [
      "ok",
