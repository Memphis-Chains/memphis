    {
      "name": "one file",
      "arguments": {
        "intent": "fix the parser",
        "files": [
          "src/parser.ts"
        ],
        "changes": {
          "src/parser.ts": "export const parse = 1;\n"
        }
      },
      "expected": {
        "payload": "{\"intent\":\"fix the parser\",\"files\":[\"src/parser.ts\"],\"changes\":{\"src/parser.ts\":\"export const parse = 1;\\n\"}}",
        "digest": "6dfb7a9a478d5fceb87467dd6afac97fa23094ec50e578a9690111f2fef45f72"
      }
